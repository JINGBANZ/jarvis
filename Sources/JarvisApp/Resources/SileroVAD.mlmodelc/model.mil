            tensor<fp32, [1, 1]> prob = expand_dims(axes = var_88_axes_0, x = var_87)[name = tensor<string, []>("op_88")];
            tensor<int32, []> var_90_axis_0 = const()[name = tensor<string, []>("op_90_axis_0"), val = tensor<int32, []>(0)];
            tensor<fp32, [2, 1, 128]> state_out = stack(axis = var_90_axis_0, values = (h, c))[name = tensor<string, []>("op_90")];
        } -> (prob, state_out);
}