{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jarvis-website",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "hijarvis.xyz",
      "custom_domain": true,
      "previews_enabled": true
    }
  ],
  "previews": {},
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  }
}
