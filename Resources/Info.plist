<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>Jarvis</string>
  <key>CFBundleDisplayName</key><string>Jarvis</string>
  <key>CFBundleIdentifier</key><string>com.jarvis.coach</string>
  <!-- Versions are bumped by release-please (the generic updater rewrites the semver on any line
       carrying the annotation) — don't edit them by hand. -->
  <key>CFBundleVersion</key><string>0.1.7</string> <!-- x-release-please-version -->
  <key>CFBundleShortVersionString</key><string>0.1.7</string> <!-- x-release-please-version -->
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleExecutable</key><string>JarvisApp</string>
  <key>CFBundleIconFile</key><string>Jarvis.icns</string>
  <key>LSMinimumSystemVersion</key><string>14.2</string>
  <key>LSUIElement</key><true/>
  <!-- Sparkle, for the menu bar's "Check for Updates" item. The feed is the appcast.xml asset
       published beside Jarvis.dmg on each Release; /releases/latest/ resolves to the newest
       published one. scripts/build-app.sh removes SUFeedURL from the development bundle, which is
       how a local build ends up with no updater at all.
       Checks are user-initiated only: SUEnableAutomaticChecks stays false so Sparkle neither
       schedules background checks nor shows its first-launch prompt asking to enable them, both of
       which would present UI on an autonomous path. -->
  <key>SUFeedURL</key>
  <string>https://github.com/JINGBANZ/jarvis/releases/latest/download/appcast.xml</string>
  <key>SUEnableAutomaticChecks</key><false/>
  <key>SUPublicEDKey</key><string>fEBUrYCXKdBM3WEbp0qnmEuAdMVgmo/udw2WYgeXFO8=</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>Jarvis listens to you think aloud to offer coaching tips.</string>
  <key>NSAudioCaptureUsageDescription</key>
  <string>Jarvis captures system audio so it can hear the other side of your call and coach you in context.</string>
  <key>NSScreenCaptureUsageDescription</key>
  <string>Jarvis captures the meeting audio (the other side of your call) and screen so it can hear what others say and coach you in context.</string>
</dict>
</plist>
